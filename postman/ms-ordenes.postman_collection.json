{
  "info": {
    "name": "ms-ordenes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "authUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "ordenId",
      "value": "1"
    },
    {
      "key": "tokenStaff",
      "value": ""
    },
    {
      "key": "tokenUser",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0a. Login STAFF (ms-auth)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{authUrl}}/api/v1/auth/login",
          "host": [
            "{{authUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@eventpass.com\",\n  \"password\": \"admin123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenStaff', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "0b. Login USER / comprador (ms-auth)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{authUrl}}/api/v1/auth/login",
          "host": [
            "{{authUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@eventpass.com\",\n  \"password\": \"user123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('tokenUser', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Crear orden como USER (201, PENDIENTE_EMISION)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/ordenes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "ordenes"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenUser}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": 1,\n  \"tipoEntradaId\": 1,\n  \"cantidad\": 2\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const o = pm.response.json();",
              "pm.test('Queda PENDIENTE_EMISION', () => pm.expect(o.estado).to.eql('PENDIENTE_EMISION'));",
              "pm.collectionVariables.set('ordenId', o.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Mis ordenes como USER (200)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
